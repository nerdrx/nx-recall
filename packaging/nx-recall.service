[Unit]
Description=NX Recall capture daemon
Documentation=https://github.com/nerdrx/nx-recall
# Ordering only, never a dependency: recalld starts fine without PipeWire and
# picks the graph up when it appears, and refusing to start would lose capture
# on every session where audio comes up second.
After=pipewire.service
After=graphical-session.target

[Service]
Type=simple
# The daemon, not the GUI. The GUI is a client that may or may not be running
# (DESIGN §2), and pause survives it either way.
ExecStart=%h/.local/bin/recalld run
# An update should update: with NXR_EXIT_ON_UPGRADE the daemon notices its
# binary was replaced on disk, drains, and exits cleanly — Restart=always then
# brings up the new version. `systemctl --user stop` still stops it for real
# (Restart= never applies to a manual stop).
Environment=NXR_EXIT_ON_UPGRADE=1
Restart=always
RestartSec=2

# DESIGN §4: "analysis must never win a scheduling contest against a VR frame."
# The whole pipeline is under 5% of one core, so this costs nothing and removes
# the one failure mode measured live on the dev box.
# 0.11.2: the PROCESS runs at normal priority and every analysis thread lowers
# ITSELF (nice 19; background passes in SCHED_IDLE, see pipeline.rs). The unit
# used to say Nice=19 for the whole daemon, which put the PipeWire capture
# thread at the same priority as the night shift, the digests and the
# translator running beside it — and on the first night all four ran, the
# capture thread missed its deadlines 658 times in one hour (audio gaps,
# discarded turns). Capture costs under one percent of a core; it must never
# queue behind the daemon's own homework.
Nice=0

# CPU placement is deliberately NOT set here. Which cores to avoid is a property
# of the machine, not of the package: put `inference_cpus` in
# ~/.config/nx-recall/config.toml instead (e.g. `[runtime]` inference_cpus =
# [16,17,...] to keep an X3D die free for the game).

NoNewPrivileges=true

[Install]
WantedBy=default.target
