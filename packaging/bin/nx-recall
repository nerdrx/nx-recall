#!/bin/sh
# NX Recall desktop app launcher — this is what the hub's Launch button and the
# desktop entry both run.
#
# The GUI is only a client (DESIGN §2), but "Launch" in the hub means "the app
# works", so if the daemon's socket is absent we start the unit (start, not
# enable: whether it autostarts at login stays the user's systemctl decision).
# Capture remains default-deny regardless — starting recalld records nothing
# the user hasn't explicitly allowed.
#
# Flags are forwarded to the app verbatim (both exec lines below end in "$@"),
# which is the whole of the launcher's part in:
#
#   nx-recall --captions   put the live caption bar on screen
#   nx-recall --minimized  start to the tray with no window
#
# `--captions` works whether or not a copy is already running: a second
# invocation loses the single-instance lock and hands its command line to the
# copy that holds it, which reads the flag and raises the bar (src/main/index.js).
set -eu

sock="${NXR_SOCKET:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nx-recall.sock}"
if [ ! -S "$sock" ]; then
    systemctl --user start nx-recall.service 2>/dev/null || true
fi

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
prefix=$(CDPATH= cd -- "$here/.." && pwd)
app="$prefix/lib/nx-recall/gui"
bin="$app/nx-recall-gui"

[ -x "$bin" ] || {
    echo "nx-recall: $bin is missing — the install is incomplete." >&2
    exit 1
}

# Chromium's setuid sandbox helper needs to be root-owned and mode 4755, which
# no unprivileged install can arrange — the hub never elevates (PUBLISHING §8).
# So: use the sandbox when someone has set it up by hand, and disable it rather
# than fail to start when they have not. See README-NX.md.
if [ -u "$app/chrome-sandbox" ]; then
    exec "$bin" "$@"
else
    exec "$bin" --no-sandbox "$@"
fi
