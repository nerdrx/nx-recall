root ::= "{" ws "\"is_commitment\":" ws verdict ws "}"
verdict ::= "false" | "true" "," ws "\"who\":" ws who "," ws "\"what\":" ws str "," ws "\"due\":" ws (null | str)
null ::= "null"
who ::= "\"A\"" | "\"B\""
str ::= "\"" chars "\""
chars ::= char chars | char
char ::= [^"\\\x00-\x1f] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
ws ::= [ \t\n]?
