{
  "name": "nx-recall-gui",
  "productName": "NX Recall",
  "version": "0.17.1",
  "description": "NX Recall — desktop client for recalld: live transcript, speakers, search, sources, and the pause switch",
  "main": "src/main/index.js",
  "type": "module",
  "author": "nerdrx",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "mock": "node mock/mockd.js",
    "start:mock": "node scripts/run_mock.js",
    "test": "node --test test/*.test.js",
    "headless": "bash scripts/headless_test.sh",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^44.1.0"
  },
  "build": {
    "appId": "com.nxrecall.gui",
    "productName": "NX Recall",
    "directories": { "output": "dist" },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!test/**/*",
      "!mock/**/*",
      "!dist/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons",
      "category": "Utility",
      "artifactName": "NX-Recall-${version}-linux.${ext}",
      "synopsis": "Local-first conversation recall — live transcript, speakers, search",
      "desktop": {
        "GenericName": "Conversation Recall",
        "StartupWMClass": "NX Recall",
        "Keywords": "nx;transcript;speakers;recall;local;"
      }
    }
  },
  "allowScripts": {
    "electron@44.1.0": true
  }
}
