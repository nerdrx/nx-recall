# Rust
/target/
# `spike/livegpu_bench` is detached from the workspace (FINDINGS §40), so it
# builds into its own tree — 2.3 GB of it, since it links the whole daemon.
spike/*/target/
**/*.rs.bk

# Release artifacts: packaging/build-release.sh output, ~140 MB a shot.
/dist/

# Step 0 spike artefacts (the spike itself is tracked, its heavy outputs are not)
spike/venv/
spike/models/

# Analysis models: hundreds of megabytes, fetched or copied in by hand.
# `NXR_MODELS=<dir>` points the acceptance suite at one.
/models-local/
spike/__pycache__/
spike/vecs_*.npz
spike/labels/
spike/clips/

# Recordings and captured audio
*.flac
*.opus

# Local daemon state (never commit captured data)
/data/
/var/
**/segments/
**/recall.db
**/recall.db-wal
**/recall.db-shm
**/nx-recall-data/

# Editor / OS
.DS_Store
*.swp

# agent worktrees (created by the harness, never source)
.claude/worktrees/
